#!/bin/sh
# Checks a commit message: Conventional Commits (`type(scope): subject`), a subject of at most 100
# characters (aim for 72) with no full stop, where ALLOW_AI_CREDIT is 0 no AI attribution, no word from the scrub
# list, where the notes are private no path into docs/, and a "Protected: <why>" line when the commit changes a
# path HEAD's CODEOWNERS lists.
# The types and scopes are the names in backticks on the "- **Types:**" and "- **Scopes:**" lines of the root
# CONTRIBUTING.md, as it is staged, so a commit can add a scope and use it. With no scopes listed, any passes.
# Copy it, checks.sh and scrub.sh into the project's hooks folder and run once per clone: git config core.hooksPath <folder>
# In CI, scripts/ci-checks.sh runs it on each commit's stored message with CHECK_COMMIT set (see checks.sh).

# 0 refuses a message that credits an AI (a Co-Authored-By trailer or a "Generated with" line). Match CONTRIBUTING.md.
ALLOW_AI_CREDIT=1
. "$(dirname "$0")/checks.sh"

# Below the scissors line that `git commit -v` adds is the diff, not the message.
msg="$(sed '/^# -* >8 -*$/,$d' "$1")"
subject="$(printf '%s\n' "$msg" | git stripspace --strip-comments | head -n 1)"

# names <label>: the names in backticks on CONTRIBUTING.md's "- **<label>:**" line, HTML comments dropped.
names() {
    printf '%s\n' "$contributing" | awk -v label="- **$1:**" 'index($0, label) == 1 {
        while ((i = index($0, "<!--")) > 0) {
            rest = substr($0, i + 4)
            j = index(rest, "-->")
            $0 = substr($0, 1, i - 1) (j ? substr(rest, j + 3) : "")
        }
        print
        exit
    }' | grep -o '`[a-z0-9-]*`' | tr -d '`' | tr '\n' ' ' | sed 's/ $//'
}
staged=0 types="" scopes=""
# ":CONTRIBUTING.md" is the staged copy; in CI, "<commit>:CONTRIBUTING.md" the commit's.
if contributing="$(git cat-file blob "$CHECK_COMMIT:CONTRIBUTING.md" 2>/dev/null)"; then
    staged=1 types="$(names Types)" scopes="$(names Scopes)"
fi

# Subjects git writes itself skip the type check. In CI a fixup or a "Merge" subject on a plain commit is a
# mistake, since it would land on main as it is; a real merge's subject is git's or GitHub's.
exempt='^(Merge |Revert "|(fixup|squash|amend)! )'
[ -n "$CHECK_COMMIT" ] && exempt='^Revert "'
[ -n "$CHECK_MERGE" ] && exempt=''
if [ -z "$subject" ]; then
    refuse "the message is empty"
elif ! printf '%s\n' "$subject" | grep -Eq "$exempt"; then
    if [ "$staged" = 0 ]; then
        refuse "there's no CONTRIBUTING.md in the commit; its \"- **Types:**\" line lists the commit types"
    elif [ -z "$types" ]; then
        refuse "CONTRIBUTING.md has no \"- **Types:**\" line that lists the commit types in backticks"
    elif ! printf '%s\n' "$subject" | grep -Eq "^($(echo "$types" | tr ' ' '|'))(\([a-z0-9-]+\))?!?: [^ ]"; then
        refuse "the subject isn't \"type(scope): subject\" with one of: $types"
    else
        scope="$(printf '%s\n' "$subject" | sed -n 's/^[a-z0-9-]*(\([a-z0-9-]*\)).*/\1/p')"
        [ -n "$scope" ] && [ -n "$scopes" ] && ! printf ' %s ' "$scopes" | grep -qF " $scope " &&
            refuse "the scope \"$scope\" isn't one of CONTRIBUTING.md's: $scopes"
    fi
    case "$subject" in *.) refuse "the subject ends with a full stop" ;; esac
    length=${#subject}
    if [ "$length" -gt 100 ]; then
        refuse "the subject has $length characters; at most 100, aiming for 72"
    elif [ "$length" -gt 72 ]; then
        echo "commit-msg: the subject has $length characters; aim for 72" >&2
    fi
fi

# Every line, comments included: with -m, git keeps lines that start with #.
if [ "$ALLOW_AI_CREDIT" = 0 ]; then
    printf '%s\n' "$msg" | grep -Eiq '^co-authored-by:.*(claude|copilot|gpt|gemini|openai|anthropic)' &&
        refuse "a Co-Authored-By line names an AI; this project's commits carry no AI attribution"
    printf '%s\n' "$msg" | grep -iq 'generated with' &&
        refuse "no \"Generated with\" lines; this project's commits carry no AI attribution"
fi
printf '%s\n' "$msg" | scrub "the commit message" || fail=1

# Skipped in a merge (CHECK_MERGE in CI): it brings the other side's protected changes, which CI checks on their own
# commits.
# shortcut: under --amend or a reword HEAD is already the commit, so paths only it changed are missed; CI checks
# each commit in full.
if [ -z "$CHECK_MERGE" ] && ! git rev-parse -q --verify MERGE_HEAD >/dev/null; then
    if ! protected="$(protected_paths)"; then
        refuse "couldn't match the changed paths against CODEOWNERS, so the commit can't be checked"
    elif [ -n "$protected" ] && ! printf '%s\n' "$msg" | git stripspace --strip-comments | grep -q '^Protected: [^[:space:]]'; then
        refuse "CODEOWNERS protects $(printf '%s\n' "$protected" | tr '\n' ' '); say why in a line \"Protected: <why>\""
    fi
fi

# After an editor, without comments: its status lines name the files, deleted ones included. With -m or -F (git sets
# GIT_EDITOR to ":" when no editor runs) and in CI, the message is read in full: git keeps lines that start with #
# then, and all of what's stored is public.
if notes_private; then
    if [ -n "$CHECK_COMMIT" ] || [ "$GIT_EDITOR" = : ]; then
        public="$(cat "$1")"
    else
        public="$(printf '%s\n' "$msg" | git stripspace --strip-comments)"
    fi
    links="$(printf '%s\n' "$public" | notes_links)"
    [ -n "$links" ] && refuse "the notes are private here, so the message may not point into docs/:
$links"
fi
exit $fail
